"help.title" = "How to play";
"help.done" = "Done";
"help.how.title" = "The game";
"help.how.body" = "Climb a skyscraper under construction by jumping from girder to girder, as high as you can. You can pass through girders from below and land on top of them. Girders get narrower as you climb.";
"help.controls.title" = "Controls";
"help.controls.body" = "Hold the arrows on the left half of the screen to run, and tap the right half to jump. The faster you run, the higher you jump. Hit a wall and you bounce off it, keeping your speed.";
"help.combo.title" = "Combo";
"help.combo.body" = "Jump two or more floors at once to start a combo. Make another multi-floor jump within three seconds to grow it. A combo ends when you jump only one floor, fall down, or run out of time. A combo of at least two jumps scores the number of floors squared.";
"help.burn.title" = "Burning film";
"help.burn.body" = "After the fifth floor, the film starts burning from the bottom and keeps speeding up. If the burning edge catches you, the game ends.";
"help.privacy.title" = "Privacy";
"help.privacy.body" = "The game works offline. There are no ads, purchases, accounts, or data collection. Your best score is stored only on this device.";
