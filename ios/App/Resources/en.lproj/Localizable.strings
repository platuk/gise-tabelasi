"settings.about.title" = "About";
"settings.about.body" = "CupTower: The Trophy Tower. The drawings, music, and sound effects are generated in code inside the game; it is an original work inspired by 1930s cartoons.";
"help.menu.title" = "Menu and intermission";
"help.menu.body" = "During a game, the pause button at the top stops the game; it also pauses by itself when your phone goes to the background. From the intermission menu you can resume (with a 3-2-1 countdown), restart, open settings, or go back to the title screen. Settings include music and effect volume, vibration, screen shake, and film effects.";
