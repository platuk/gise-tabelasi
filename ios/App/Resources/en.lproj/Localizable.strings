"help.title" = "How to play";
"help.done" = "Done";
"help.how.title" = "The game";
"help.how.body" = "Each letter on the sign is a reel. Turn a reel with the arrow buttons or by swiping up or down. When the sign spells a target word, a light turns on. Light every bulb to finish the level.";
"help.undo.title" = "Undo";
"help.undo.body" = "Undo turns back your last reel move. Words you found stay found; wrong moves are never punished.";
"help.locks.title" = "Locked levels";
"help.locks.body" = "A level opens when you finish the one before it. There is no other way to unlock levels.";
"help.language.title" = "Puzzle language";
"help.language.body" = "Pick Turkish or English puzzles at the top right. Each language keeps its own progress; switching never erases it.";
"help.privacy.title" = "Privacy";
"help.privacy.body" = "The game works offline. There are no ads, purchases, accounts, or data collection. Your progress is stored only on this device.";
